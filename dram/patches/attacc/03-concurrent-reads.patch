diff --git a/ramulator2/src/frontend/impl/memory_trace/pim_dual_trace.cpp b/ramulator2/src/frontend/impl/memory_trace/pim_dual_trace.cpp
new file mode 100644
index 0000000..072ae25
--- /dev/null
+++ b/ramulator2/src/frontend/impl/memory_trace/pim_dual_trace.cpp
@@ -0,0 +1,164 @@
+#include <filesystem>
+#include <iostream>
+#include <fstream>
+
+#include "frontend/frontend.h"
+#include "base/exception.h"
+
+namespace Ramulator {
+
+namespace fs = std::filesystem;
+
+// a PIM command trace and a concurrent stream of reads (a GPU streaming weights while PIM runs).
+// The two streams are sent independently, so a full PIM buffer does not hold back the reads and vice versa (the
+// single-stream PIMLoadStoreTrace sends in trace order). The read stream wraps around and runs while the PIM trace has
+// requests left; read_rate limits it to that many reads per memory cycle (< 0: as many as the controllers take, 0: none).
+// With read_count > 0 the read stream sends read_count reads and stops (with or without a PIM trace); the run ends
+// when both streams are sent and the controllers have drained.
+class PIMDualTrace : public IFrontEnd, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IFrontEnd, PIMDualTrace, "PIMDualTrace", "PIM trace with a concurrent read stream.")
+
+  private:
+    struct Trace {
+      int req_type;
+      Addr_t addr;
+    };
+    std::vector<Trace> m_pim;
+    std::vector<Addr_t> m_reads;
+    size_t m_pim_idx = 0;
+    size_t m_rd_idx = 0;
+    double m_read_rate = -1.0;
+    double m_budget = 0.0;
+    size_t m_read_count = 0;
+
+    uint64_t m_cycle = 0;
+    size_t s_reads_sent = 0;
+    size_t s_pim_sent = 0;
+    uint64_t s_pim_sent_cycle = 0;
+    uint64_t s_reads_sent_cycle = 0;
+
+    Logger_t m_logger;
+
+  public:
+    void init() override {
+      std::string pim_path = param<std::string>("path").desc("PIM trace (empty: read-only run).").default_val("");
+      std::string read_path = param<std::string>("read_path").desc("Read address list, one address per line.").required();
+      m_clock_ratio = param<uint>("clock_ratio").required();
+      m_read_rate = param<double>("read_rate").desc("Reads per memory cycle (< 0: unlimited, 0: none).").default_val(-1.0);
+      m_read_count = param<size_t>("read_count").desc("Reads to send in a read-only run.").default_val(0);
+
+      m_logger = Logging::create_logger("PIMDualTrace");
+      if (!pim_path.empty()) {
+        load_pim(pim_path);
+      }
+      load_reads(read_path);
+      m_logger->info("Loaded {} PIM requests and {} read addresses.", m_pim.size(), m_reads.size());
+
+      register_stat(s_reads_sent).name("dual_reads_sent");
+      register_stat(s_pim_sent).name("dual_pim_sent");
+      register_stat(s_pim_sent_cycle).name("dual_pim_sent_cycle");
+      register_stat(s_reads_sent_cycle).name("dual_reads_sent_cycle");
+    };
+
+    void tick() override {
+      m_cycle++;
+      // PIM stream first (the controller also gives PIM priority over reads)
+      while (m_pim_idx < m_pim.size()) {
+        const Trace& t = m_pim[m_pim_idx];
+        if (!m_memory_system->send({t.addr, t.req_type})) {
+          break;
+        }
+        m_pim_idx++;
+        s_pim_sent++;
+      }
+      if (!m_pim.empty() && m_pim_idx == m_pim.size() && s_pim_sent_cycle == 0) {
+        s_pim_sent_cycle = m_cycle;
+      }
+      // read stream
+      bool reads_on = m_read_count > 0 ? (s_reads_sent < m_read_count) : (!m_pim.empty() && m_pim_idx < m_pim.size());
+      if (!reads_on || m_reads.empty() || m_read_rate == 0.0) {
+        return;
+      }
+      if (m_read_rate > 0) {
+        m_budget = std::min(m_budget + m_read_rate, m_read_rate + 64.0);
+      }
+      while ((m_read_rate < 0 || m_budget >= 1.0) && (m_read_count == 0 || s_reads_sent < m_read_count)) {
+        if (!m_memory_system->send({m_reads[m_rd_idx], Request::Type::Read})) {
+          break;
+        }
+        m_rd_idx = (m_rd_idx + 1) % m_reads.size();
+        s_reads_sent++;
+        if (m_read_rate > 0) {
+          m_budget -= 1.0;
+        }
+      }
+      if (m_read_count > 0 && s_reads_sent >= m_read_count && s_reads_sent_cycle == 0) {
+        s_reads_sent_cycle = m_cycle;
+      }
+    };
+
+    bool is_finished() override {
+      bool pim_done = m_pim_idx >= m_pim.size();
+      bool reads_done = m_read_count == 0 || s_reads_sent >= m_read_count;
+      return pim_done && reads_done;
+    };
+
+  private:
+    static int pim_type(const std::string& tok) {
+      if (tok == "LD")             return Request::Type::Read;
+      if (tok == "ST")             return Request::Type::Write;
+      if (tok == "PIM_MAC_AB")     return Request::Type::PIM_MAC_AB;
+      if (tok == "PIM_MAC_SB")     return Request::Type::PIM_MAC_SB;
+      if (tok == "PIM_MAC_PB")     return Request::Type::PIM_MAC_PB;
+      if (tok == "PIM_WR_GB")      return Request::Type::PIM_WR_GB;
+      if (tok == "PIM_MV_SB")      return Request::Type::PIM_MV_SB;
+      if (tok == "PIM_MV_GB")      return Request::Type::PIM_MV_GB;
+      if (tok == "PIM_SFM")        return Request::Type::PIM_SFM;
+      if (tok == "PIM_SET_MODEL")  return Request::Type::PIM_SET_MODEL;
+      if (tok == "PIM_SET_HEAD")   return Request::Type::PIM_SET_HEAD;
+      if (tok == "PIM_BARRIER")    return Request::Type::PIM_BARRIER;
+      return -1;
+    }
+
+    static Addr_t parse_addr(const std::string& tok) {
+      if (tok.compare(0, 2, "0x") == 0 || tok.compare(0, 2, "0X") == 0) {
+        return std::stoll(tok.substr(2), nullptr, 16);
+      }
+      return std::stoll(tok);
+    }
+
+    void load_pim(const std::string& path) {
+      if (!fs::exists(path)) {
+        throw ConfigurationError("Trace {} does not exist!", path);
+      }
+      std::ifstream f(path);
+      std::string line;
+      while (std::getline(f, line)) {
+        std::vector<std::string> tokens;
+        tokenize(tokens, line, " ");
+        if (tokens.size() != 2) {
+          throw ConfigurationError("Trace {} format invalid!", path);
+        }
+        int type = pim_type(tokens[0]);
+        if (type < 0) {
+          throw ConfigurationError("Trace {} format invalid!", path);
+        }
+        m_pim.push_back({type, parse_addr(tokens[1])});
+      }
+    }
+
+    void load_reads(const std::string& path) {
+      if (!fs::exists(path)) {
+        throw ConfigurationError("Read list {} does not exist!", path);
+      }
+      std::ifstream f(path);
+      std::string line;
+      while (std::getline(f, line)) {
+        if (!line.empty()) {
+          m_reads.push_back(parse_addr(line));
+        }
+      }
+    }
+};
+
+}        // namespace Ramulator
