diff --git a/ramulator2/src/dram_controller/impl/refresh/per_bank_refresh_hbm3.cpp b/ramulator2/src/dram_controller/impl/refresh/per_bank_refresh_hbm3.cpp
new file mode 100644
index 0000000..967f7d0
--- /dev/null
+++ b/ramulator2/src/dram_controller/impl/refresh/per_bank_refresh_hbm3.cpp
@@ -0,0 +1,119 @@
+#include <vector>
+
+#include "base/base.h"
+#include "dram_controller/controller.h"
+#include "dram_controller/refresh.h"
+
+namespace Ramulator {
+
+// Per-bank (same-bank) refresh for HBM3: every bank of every pseudo channel gets one REFsb per tREFI.
+//   policy "batched": at each tREFI, REFsb to all banks of each pseudo channel back to back, alternating SIDs
+//                     (a PIM-aware controller that groups the per-bank refreshes; best case for all-bank PIM)
+//   policy "spread":  REFsb to one bank of each pseudo channel every tREFI / (banks per pseudo channel),
+//                     round-robin (the usual per-bank refresh schedule)
+// tREFI comes from nREFI (a 2x refresh run halves it); the per-bank interval is computed here as
+// nREFI / banks instead of the preset nREFISB, whose stack-height lookup is indexed by the SID count.
+// tRFCsb is nRFCSB (HBM3-PIM presets: 260 / 320 cycles = 200 ns, independent of density; override it in the config).
+// "spread" with nRFCSB >= the per-bank interval never lets an all-bank PIM ACTAB through, so it is refused.
+class PerBankRefreshHBM3 : public IRefreshManager, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IRefreshManager, PerBankRefreshHBM3, "PerBankHBM3", "Per-bank refresh scheme for HBM3.")
+  private:
+    Clk_t m_clk = 0;
+    IDRAM* m_dram;
+    IDRAMController* m_ctrl;
+
+    std::string m_policy;
+    int m_dram_org_levels = -1;
+    int m_num_pch = -1;
+    int m_num_ranks = -1;
+    int m_num_bgs = -1;
+    int m_num_banks = -1;
+    int m_banks_per_pch = -1;
+
+    int m_nrefi = -1;
+    int m_interval = -1;
+    int m_ref_req_id = -1;
+    Clk_t m_next_refresh_cycle = -1;
+    int m_next_bank = 0;           // spread: flat bank index (rank, bg, bank) refreshed next in every pseudo channel
+
+    int m_lv_pch = -1, m_lv_rank = -1, m_lv_bg = -1, m_lv_bank = -1;
+
+    void send(int pch, int flat) {
+      std::vector<int> addr_vec(m_dram_org_levels, -1);
+      addr_vec[0] = m_ctrl->m_channel_id;
+      addr_vec[m_lv_pch] = pch;
+      addr_vec[m_lv_rank] = flat / (m_num_bgs * m_num_banks);
+      addr_vec[m_lv_bg] = (flat / m_num_banks) % m_num_bgs;
+      addr_vec[m_lv_bank] = flat % m_num_banks;
+      Request req(addr_vec, m_ref_req_id);
+      if (!m_ctrl->priority_send(req)) {
+        throw std::runtime_error("Failed to send per-bank refresh!");
+      }
+    }
+
+  public:
+    void init() override {
+      m_ctrl = cast_parent<IDRAMController>();
+      m_policy = param<std::string>("policy").desc("batched or spread").default_val("batched");
+      if (m_policy != "batched" && m_policy != "spread") {
+        throw ConfigurationError("PerBankHBM3: policy must be batched or spread, got {}", m_policy);
+      }
+    };
+
+    void setup(IFrontEnd* frontend, IMemorySystem* memory_system) override {
+      m_dram = m_ctrl->m_dram;
+
+      m_dram_org_levels = m_dram->m_levels.size();
+      m_lv_pch = m_dram->m_levels("pseudochannel");
+      m_lv_rank = m_dram->m_levels("rank");
+      m_lv_bg = m_dram->m_levels("bankgroup");
+      m_lv_bank = m_dram->m_levels("bank");
+      m_num_pch = m_dram->get_level_size("pseudochannel");
+      m_num_ranks = m_dram->get_level_size("rank");
+      m_num_bgs = m_dram->get_level_size("bankgroup");
+      m_num_banks = m_dram->get_level_size("bank");
+      m_banks_per_pch = m_num_ranks * m_num_bgs * m_num_banks;
+
+      m_nrefi = m_dram->m_timing_vals("nREFI");
+      if (m_dram->m_timing_vals("nRFCSB") <= 0) {
+        throw ConfigurationError("PerBankHBM3: nRFCSB must be positive");
+      }
+      m_interval = (m_policy == "batched") ? m_nrefi : m_nrefi / m_banks_per_pch;
+      if (m_interval <= 0) {
+        throw ConfigurationError("PerBankHBM3: refresh interval {} cycles", m_interval);
+      }
+      if (m_policy == "spread" && m_dram->m_timing_vals("nRFCSB") >= m_interval) {
+        throw ConfigurationError("PerBankHBM3: spread schedule starves all-bank PIM (nRFCSB {} >= interval {})",
+                                 m_dram->m_timing_vals("nRFCSB"), m_interval);
+      }
+      m_ref_req_id = m_dram->m_requests("per-bank-refresh");
+      m_next_refresh_cycle = m_interval;
+    };
+
+    void tick() {
+      m_clk++;
+
+      if (m_clk == m_next_refresh_cycle) {
+        m_next_refresh_cycle += m_interval;
+        if (m_policy == "batched") {
+          // tRREFD spaces REFsb within a rank (SID): alternate SIDs and pseudo channels so the batch overlaps
+          int per_rank = m_num_bgs * m_num_banks;
+          for (int i = 0; i < per_rank; i++) {
+            for (int r = 0; r < m_num_ranks; r++) {
+              for (int pch = 0; pch < m_num_pch; pch++) {
+                send(pch, r * per_rank + i);
+              }
+            }
+          }
+        } else {
+          for (int pch = 0; pch < m_num_pch; pch++) {
+            send(pch, m_next_bank);
+          }
+          m_next_bank = (m_next_bank + 1) % m_banks_per_pch;
+        }
+      }
+    };
+
+};
+
+}       // namespace Ramulator
