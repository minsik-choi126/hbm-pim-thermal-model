+    void HBM3::handleRefAll(Rank &rank, timestamp_t timestamp) {
+        // Mirrors DDR4::handleRefAll: every bank is busy (active) for tRFC, then implicitly
+        // precharged. The rank-active interval feeds E_bg_act_shared for the window; the excess
+        // refresh current (IDD5B - IDD3N1) is charged per bank in core_calculation_HBM3.
+        auto tRFC = memSpec.memTimingSpec.tRFC;
+        if (tRFC == 0) {
+            static bool warned = false;
+            if (!warned) { std::cout << "[WARN] REFA seen but tRFC == 0: refresh energy NOT modeled" << std::endl; warned = true; }
+            return;
+        }
+        auto timestamp_end = timestamp + tRFC;
+        rank.endRefreshTime = timestamp_end;
+        rank.cycles.act.start_interval_if_not_running(timestamp);
+        for (auto &bank : rank.banks) {
+            bank.bankState = Bank::BankState::BANK_ACTIVE;
+            ++bank.counter.refAllBank;
+            bank.cycles.act.start_interval_if_not_running(timestamp);
+            bank.refreshEndTime = timestamp_end;
+            addImplicitCommand(timestamp_end, [this, &bank, &rank, timestamp_end]() {
+                bank.bankState = Bank::BankState::BANK_PRECHARGED;
+                bank.cycles.act.close_interval(timestamp_end);
+                if (!rank.isActive(timestamp_end))
+                    rank.cycles.act.close_interval(timestamp_end);
+            });
+        }
+    }
+
     void HBM3::handleRead(Rank &, Bank &bank, timestamp_t) {
         ++bank.counter.reads;
     }
