diff --git a/sources/LLMSimulator/CMakeLists.txt b/sources/LLMSimulator/CMakeLists.txt
index ba4798c..177b5ee 100644
--- a/sources/LLMSimulator/CMakeLists.txt
+++ b/sources/LLMSimulator/CMakeLists.txt
@@ -2,6 +2,22 @@ CMAKE_MINIMUM_REQUIRED (VERSION 3.14)
 
 PROJECT (llm_system)
 
+# Apple clang defaults to C++14 (g++ >= 11 defaults to gnu++17); the simulator
+# uses std::filesystem/std::optional and includes Ramulator2's C++20 headers.
+if(NOT CMAKE_CXX_STANDARD)
+    set(CMAKE_CXX_STANDARD 20)
+    set(CMAKE_CXX_STANDARD_REQUIRED ON)
+    set(CMAKE_CXX_EXTENSIONS OFF)
+endif()
+
+
+# spdlog 1.11.0 (fetched by Ramulator2) bundles fmt 9.1.0, whose consteval
+# FMT_STRING checker is rejected by recent Apple clang ("call to consteval
+# function ... is not a constant expression"). Every target that includes
+# Ramulator headers pulls spdlog in, so define it globally. Same runtime behaviour.
+if(APPLE)
+    add_compile_definitions(FMT_CONSTEVAL=)
+endif()
 
 add_library(llm_system SHARED)
 add_compile_options(-fPIC)
@@ -13,10 +29,18 @@ add_subdirectory(src)
 add_subdirectory(eval)
 
 
+# The dram archive must be linked whole (static-registration of Ramulator impls).
+# GNU ld: --whole-archive; Apple ld64/ld-prime: -force_load <archive>.
+if(APPLE)
+    set(DRAM_WHOLE_ARCHIVE -Wl,-force_load,$<TARGET_FILE:dram> dram)
+else()
+    set(DRAM_WHOLE_ARCHIVE -Wl,--whole-archive dram -Wl,--no-whole-archive)
+endif()
+
 target_link_libraries(
     llm_system
     PRIVATE hardware
-    PRIVATE -Wl,--whole-archive dram -Wl,--no-whole-archive 
+    PRIVATE ${DRAM_WHOLE_ARCHIVE}
     #PRIVATE dram
     PRIVATE module
     PRIVATE model
