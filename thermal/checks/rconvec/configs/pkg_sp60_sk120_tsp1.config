# HotSpot 6.0 package parameters for the H100 model, ambient 50 C (323.15 K).
# Heat-sink and spreader thickness and materials follow the 2.5D setup of HotSpot-HMS (Hong et al., HPCA 2024); their
# sides are sized for the H100 package (s_spreader 45.6 mm, the smallest HotSpot accepts for the 45.53 mm floorplan;
# s_sink = 1.8 x s_spreader). r_convec, grid size and sampling interval are overwritten per run by thermal/model/geom.py.
# Die, bond and TIM layers come from geometry/h100_5stack/stack.lcf.

	# chip specs
		-t_chip				0.00015
		-k_chip				100.0
		-p_chip				1.75e6
		# unused: dtm_used = 0
-thermal_threshold	354.95

	# heat sink specs
		# not rescaled from the 1-stack setup (140.4 x (0.0667602 / 0.06)^2); the rule for this sink gives 262.88.
		# Transient only (ripple study); steady results do not use it.
		-c_convec			173.82004785756001
		-r_convec			0.02883023086155433
		-s_sink 0.12
		-t_sink				0.0069
		-k_sink				400.0
		-p_sink				3.55e6

	# heat spreader specs
		-s_spreader 0.06
		-t_spreader			0.001
		-k_spreader			400.0
		-p_spreader			3.55e6

	# interface material specs (unused with a layer file: temperature_grid.c:338-371, 649-655; the TIM is stack.lcf layer 19)
		-t_interface		6.0e-04
		-k_interface		4.0
		-p_interface		4.0e6

	# secondary path (off, as in HotSpot-HMS; s_sub smaller than the package width would make the
	# temperature.c:450-451, 461-462 resistances negative)
		-model_secondary	0
		-r_convec_sec	50.0
		-c_convec_sec	40.0
		-n_metal	8
		-t_metal	100.0e-6
		-t_c4	0.0001
		-s_c4	20.0e-6
		-n_c4	400
		-s_sub	0.021
		-t_sub	0.001
		-s_solder	0.021
		-t_solder	0.00094
		-s_pcb	0.1
		-t_pcb	0.002

	# others
		-ambient			323.15
		-init_file			(null)
		-init_temp			323.15
		-steady_file		(null)
		-sampling_intvl		1e-03
		-base_proc_freq		3e+09
		-dtm_used			0
		-model_type			grid
		-leakage_used		0
		-leakage_mode		0
		-package_model_used	0
		-package_config_file	package.config

	# block model
		-block_omit_lateral	0

	# grid model
		-grid_rows			64
		-grid_cols			64
		-grid_layer_file	(null)
		-grid_steady_file	(null)
		-grid_map_mode		center

# floorplanner parameters (unused by the grid model, kept for a valid config)
		-wrap_l2			1
		-l2_label			L2
		-model_rim			0
		-rim_thickness		5e-05
		-compact_ratio		0.005
		-n_orients			300
		-P0					0.99
		-Davg				1
		-Kmoves				7
		-Rcool				0.99
		-Rreject			0.99
		-Nmax				1000
		-lambdaA			5.0e+06
		-lambdaT			1
		-lambdaW			350
