+/* dump the steady state grid temperatures of specific layer onto 'file' */
+void dump_specific_layer_temp_grid (grid_model_t *model, char *file, grid_model_vector_t *temp, int num_layer)
+{
+  int i, j;
+  char str[STR_SIZE];
+  FILE *fp;
+  int silidx;
+
+  if (!model->config.model_secondary) {
+      silidx = LAYER_SI;
+  } else {
+      if(model->has_lcf)
+        silidx = SEC_PACK_LAYERS;
+      else
+        silidx = SEC_PACK_LAYERS + SEC_CHIP_LAYERS;
+  }
+
+  if (!model->r_ready)
+    fatal("R model not ready\n");
+
+  if (!strcasecmp(file, "stdout"))
+    fp = stdout;
+  else if (!strcasecmp(file, "stderr"))
+    fp = stderr;
+  else 	
+    fp = fopen (file, "w");
 
+  if (!fp) {
+      sprintf (str,"error: %s could not be opened for writing\n", file);
+      fatal(str);
+  }
+
+  for(i=0; i < model->rows; i++){
+      for(j=0; j < model->cols; j++){
+          /* top layer of the most-recently computed 
+           * steady state temperature	
+           */
+  //        fprintf(fp, "%d\t%d\t%.2f\n", j, model->rows-i-1, 
+  //                model->last_steady->cuboid[silidx][i][j]); 
+          fprintf(fp, "%d\t%.2f\n", i*model->cols+j, 
+                  model->last_steady->cuboid[num_layer][i][j]); 
+      }
+      fprintf(fp, "\n");
+  }
+
+  //int l;
+  //for(l=0;  l < model->n_layers; l++){
+  //    for(i=0; i < model->rows; i++){
+  //        for(j=0; j < model->cols; j++){
+  //            fprintf(fp, "%d\t%.2f\n", i*model->cols+j, 
+  //                    model->last_steady->cuboid[l][i][j]); 
+  //        }
+  //    }
+  //    fprintf(fp, "\n");
+  //}
+ 
+  //rzdebug
+  //int l;
+  //double max_temp = 0;
+  //for(l=0; l<model->n_layers; l++)
+  //  for(i=0; i<model->rows; i++)
+  //    for(j=0; j<model->cols; j++)
+  //      if(model->last_steady->cuboid[l][i][j] > max_temp)
+  //        max_temp = model->last_steady->cuboid[l][i][j];
+  //printf("%lf\n", max_temp);
+
+  if(fp != stdout && fp != stderr)
+    fclose(fp);	
+}
+
+/* 204KU: to extract the steady state temperatures of all layers */
+void dump_all_layers_temp_grid (grid_model_t *model, char *file, grid_model_vector_t *temp)
+{
+	int i, len;
+	char *file_layer[model->n_layers];
+
+	len = strlen(file) + 5;
+	for(i=0; i < (model->n_layers); i++) {
+		file_layer[i] = (char *) malloc (sizeof(char) * len);
+		sprintf(file_layer[i], "%s[%d]", file, i);
+		dump_specific_layer_temp_grid(model, file_layer[i], model->last_steady, i);
+		free(file_layer[i]);
+	}
+}
+
